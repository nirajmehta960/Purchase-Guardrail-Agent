# =============================================================================
# SavVio Data Pipeline - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git — it contains sensitive credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# GCP Configuration
# -----------------------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id

# Path to your service account JSON key file (for local development).
# Leave empty/comment-out to use Application Default Credentials (ADC) in GCP.
# In docker-compose the host key is mounted at /opt/airflow/config/savvio-gcp-key.json.
GCP_CREDENTIALS_PATH=/opt/airflow/config/savvio-gcp-key.json

# -----------------------------------------------------------------------------
# GCS Storage Configuration
# -----------------------------------------------------------------------------
GCS_BUCKET_NAME=savvio-data-bucket

# GCS folder structure (with trailing slashes)
GCS_RAW_PATH=raw/
GCS_PROCESSED_PATH=processed/
GCS_FEATURES_PATH=features/
GCS_VALIDATED_PATH=validated/

# Specific blob paths for raw data
FINANCIAL_BLOB=raw/financial_data.csv
PRODUCT_BLOB=raw/product_data.jsonl
REVIEW_BLOB=raw/review_data.jsonl

# -----------------------------------------------------------------------------
# Local File Paths
# -----------------------------------------------------------------------------
DATA_DIR=dags/data

# -----------------------------------------------------------------------------
# API Configuration (Production)
# -----------------------------------------------------------------------------
# Only needed when ENVIRONMENT=prod (DATA_SOURCE=api).
# Set to your Cloud Run API URL. Leave empty for dev (GCS mode ignores this).
API_BASE_URL=
API_KEY=
API_TIMEOUT=30

# -----------------------------------------------------------------------------
# Environment Configuration
# -----------------------------------------------------------------------------
# Environment: dev, staging, or prod
ENVIRONMENT=dev

# Data source: gcs or api. If unset, derived from ENVIRONMENT (dev→gcs, prod→api).
# DATA_SOURCE=gcs

# -----------------------------------------------------------------------------
# Pipeline Configuration
# -----------------------------------------------------------------------------
MAX_MISSING_VALUES_PCT=0.1
MIN_RECORDS_REQUIRED=100
MONTHLY_INCOME_COLS=income,salary
MONTHLY_EXPENSE_COLS=rent,bills,subscriptions

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs

# -----------------------------------------------------------------------------
# DVC Configuration
# -----------------------------------------------------------------------------
DVC_REMOTE_NAME=gcs
# DVC_REMOTE_URL=gs://savvio-data-bucket/dvcstore

# -----------------------------------------------------------------------------
# Airflow
# -----------------------------------------------------------------------------
# UID of host user that owns the airflow/ logs/plugins folders (run `id -u`)
AIRFLOW_UID=501
AIRFLOW_PROJ_DIR=.

# Airflow webserver login (Docker Compose creates this user on first boot)
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=airflow

# -----------------------------------------------------------------------------
# Email Notifications (SMTP) — used by Airflow + drift_detector + CI workflows
# -----------------------------------------------------------------------------
# Project uses email-only alerting (Slack was removed). Gmail App Password works.
# Setup: https://support.google.com/accounts/answer/185833
#
# SMTP_HOST / SMTP_PORT also feed AIRFLOW_CONN_SMTP_DEFAULT in docker-compose.yaml
# so the EmailOperator tasks in data_pipeline_airflow.py inherit them automatically.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=example@gmail.com
SMTP_PASSWORD=your-16-char-app-password
ALERT_EMAIL_FROM=example@gmail.com
# Comma-separated "to" recipients used by both the drift detector and every
# EmailOperator in the Airflow DAG (data_pipeline_airflow.py).
ALERT_EMAIL_LIST=alert-recipient-1@example.com,alert-recipient-2@example.com
# Optional comma-separated CC list for the Airflow EmailOperator alerts.
ALERT_EMAIL_CC=

# -----------------------------------------------------------------------------
# Airflow DAG Metadata
# -----------------------------------------------------------------------------
# Surfaced in the Airflow UI (DAG owner field + linked profile).
DAG_OWNER=SavVio Data Team
DAG_OWNER_LINK=https://github.com/nirajmehta960/SavVio

# Optional Slack webhook (the SlackWebhookOperator tasks are commented out in
# data_pipeline_airflow.py; populate these to re-enable). SLACK_WEBHOOK_HOST is
# the URL-encoded hooks.slack.com host that AIRFLOW_CONN_SLACK_WEBHOOK expects.
SLACK_WEBHOOK_URL=
SLACK_WEBHOOK_HOST=https%3A%2F%2Fhooks.slack.com%2Fservices

# -----------------------------------------------------------------------------
# Database load tunables (upload_to_db.py / vector_embed.py)
# -----------------------------------------------------------------------------
# Streaming and batching knobs — defaults are safe for the 5G worker container.
JSONL_STREAM_CHUNKSIZE=100000
JSONL_LARGE_FILE_MB=300
UPSERT_CHUNK_SIZE=5000
REVIEWS_INSERT_PAGE_SIZE=25000

# -----------------------------------------------------------------------------
# Embeddings (vector_embed.py)
# -----------------------------------------------------------------------------
# Swap the model + dim together — pgvector enforces a fixed column width.
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=64
EMBED_STORE_CHUNK_SIZE=5000
EMBED_INSERT_BATCH_SIZE=500

# -----------------------------------------------------------------------------
# DuckDB merge tunables (incremental.py)
# -----------------------------------------------------------------------------
# 3 × DUCKDB_MEMORY_LIMIT must stay below the worker container mem_limit
# because preprocessing runs 3 DuckDB merges in parallel.
DUCKDB_MEMORY_LIMIT=1000MB
DUCKDB_THREADS=2
DUCKDB_TEMP_DIRECTORY=/tmp
JSONL_MAX_OBJECT_SIZE=33554432

# -----------------------------------------------------------------------------
# Application Database — Local Mac Postgres (via pgAdmin)
# Dev:  host.docker.internal reaches your Mac from inside Docker
# Prod: swap DB_HOST to your Cloud SQL IP/hostname (or use Cloud SQL Auth Proxy)
# -----------------------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=your-local-postgres-password
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=postgres

# DB_ENV=dev|prod — toggles whether the API uses local postgres or Cloud SQL creds
DB_ENV=dev

# -----------------------------------------------------------------------------
# LLM Configuration (Vertex AI is the default; others are optional fallbacks)
# -----------------------------------------------------------------------------
VERTEX_PROJECT=your-gcp-project-id
VERTEX_LOCATION=us-east1
# OPEN_ROUTER_API_KEY=sk-or-v1-...

# -----------------------------------------------------------------------------
# Frontend Build Arg (only used when launching the full local stack)
# -----------------------------------------------------------------------------
# URL the browser uses to reach the API; override for prod-pointed local builds.
VITE_API_BASE=http://localhost:8080

# =============================================================================
# Setup Instructions
# =============================================================================
# 1. Copy this file to .env in the same directory:
#      cp .env.example .env
# 2. Fill in your actual values in .env
# 3. Make sure .env is in .gitignore (it is — see repo root .gitignore)
# 4. For GCP authentication, either:
#      - set GCP_CREDENTIALS_PATH to a service account key file, OR
#      - run `gcloud auth application-default login` for ADC
# 5. Verify configuration:
#      python config.py
# =============================================================================
