# =============================================================================
# SavVio Deployment - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git — it contains sensitive credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# GCP Project
# -----------------------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-east1

# -----------------------------------------------------------------------------
# GCE Pipeline VM (Airflow)
# -----------------------------------------------------------------------------
VM_NAME=savvio-dev-pipeline-vm
VM_ZONE=us-east1-b
# Update after VM restarts (ephemeral external IP).
VM_IP=0.0.0.0
VM_SSH_USER=github-actions

# Airflow webserver login (matches data_pipeline/docker-compose.yaml defaults)
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=airflow

# -----------------------------------------------------------------------------
# Cloud SQL — Dev
# -----------------------------------------------------------------------------
DB_INSTANCE_CONNECTION_NAME=your-gcp-project-id:us-east1:savvio-dev-db-instance
DB_NAME=savvio-dev-db
DB_USER=dev-db-admin
DB_PASSWORD=your-cloud-sql-password
DB_PORT=5432
# DB_HOST values:
#   From inside the GCE VM/Docker: cloud-sql-proxy
#   From local Cloud SQL Auth Proxy: 127.0.0.1
DB_HOST=127.0.0.1

# DB_ENV=prod tells the API to use Cloud SQL creds instead of local postgres.
DB_ENV=prod

# -----------------------------------------------------------------------------
# GCS Buckets
# -----------------------------------------------------------------------------
GCS_DATA_BUCKET=savvio-data-bucket
GCS_DVC_BUCKET=savvio-dev-dvc-data
GCS_MLFLOW_BUCKET=savvio-dev-mlflow-artifacts

# -----------------------------------------------------------------------------
# Artifact Registry
# -----------------------------------------------------------------------------
DOCKER_REPO=us-east1-docker.pkg.dev/your-gcp-project-id/savvio-dev-docker-repo

# -----------------------------------------------------------------------------
# Cloud Run Service URLs (filled in after first deploy)
# -----------------------------------------------------------------------------
API_URL=
FRONTEND_URL=
MLFLOW_URL=

# Aliases used by application code
API_BASE_URL=
MLFLOW_TRACKING_URI=
VITE_API_BASE=

# -----------------------------------------------------------------------------
# Grafana Cloud (monitoring)
# -----------------------------------------------------------------------------
GRAFANA_CLOUD_REMOTE_WRITE_URL=https://prometheus-prod-XX-prod-us-east-X.grafana.net/api/prom/push
GRAFANA_CLOUD_USERNAME=your-grafana-instance-id
GRAFANA_CLOUD_API_KEY=your-grafana-api-key

# -----------------------------------------------------------------------------
# Email Notifications (SMTP) — drift alerts + CI workflow notifications
# -----------------------------------------------------------------------------
# Project uses email-only alerting (Slack was removed). Gmail App Password works.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=example@gmail.com
SMTP_PASSWORD=your-16-char-app-password
ALERT_EMAIL_FROM=example@gmail.com
ALERT_EMAIL_LIST=alert-recipient-1@example.com,alert-recipient-2@example.com

# -----------------------------------------------------------------------------
# LLM APIs (optional — Vertex AI is the default and uses ADC, no key required)
# -----------------------------------------------------------------------------
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_API_KEY=AIza...
# OPEN_ROUTER_API_KEY=sk-or-v1-...

# =============================================================================
# Setup Instructions
# =============================================================================
# 1. Copy this file to .env in the same directory:
#      cp deployment/.env.example deployment/.env
# 2. Fill in your actual values in deployment/.env
# 3. The same secrets are mirrored as GitHub Actions secrets — see
#    deployment/GCP_DEPLOYMENT.md for the canonical list.
# =============================================================================
