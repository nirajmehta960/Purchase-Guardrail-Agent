# Copy to deployment/.env and fill in real values. NEVER commit deployment/.env.

# ---- GCP ----
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-east1

# ---- Cloud SQL (read by savviocore.database.db_connection in DB_ENV=prod) ----
DB_INSTANCE_CONNECTION_NAME=your-gcp-project-id:us-east1:savvio-dev-db-instance
DB_NAME=savvio-dev-db
DB_USER=dev-db-admin
# In prod, the entrypoint can read either DB_PASSWORD or DB_PASS — set one.
DB_PASSWORD=your-cloud-sql-password
# DB_PASS=your-cloud-sql-password
DB_PORT=5432
# DB_HOST is the Cloud SQL Auth Proxy: 127.0.0.1 from your laptop, "cloud-sql-proxy"
# from the Compose network on the GCE VM, or "/cloudsql/<conn>" inside Cloud Run.
DB_HOST=127.0.0.1
DB_ENV=prod

# ---- API server (deployment/api/) ----
API_HOST=0.0.0.0
API_PORT=3500
# Cloud Run injects PORT — leave unset locally; PORT wins over API_PORT if both are set.
# PORT=8080
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,*
ML_MODEL_DISPLAY_NAME=SavVio classifier
# MODEL_ARTIFACT_DIR=/app/model_pipeline/models/model

# Catalog browse defaults
PRODUCT_BROWSE_PRICE_MIN=50
PRODUCT_BROWSE_PRICE_MAX=2000
PRODUCT_BROWSE_DEFAULT_LIMIT=100
PRODUCT_BROWSE_MAX_LIMIT=500

# ---- MLflow ----
# Tracking URI for the API (optional, only when loading from registry).
MLFLOW_TRACKING_URI=
# Artifact storage root used by deployment/mlflow/entrypoint.sh.
MLFLOW_ARTIFACT_ROOT=gs://your-mlflow-bucket/artifacts

# ---- Prometheus / Grafana Cloud (read by deployment/api/config.py) ----
METRICS_ENABLED=true
METRICS_PREFIX=savvio
GRAFANA_CLOUD_REMOTE_WRITE_URL=https://prometheus-prod-XX-prod-us-east-X.grafana.net/api/prom/push
GRAFANA_CLOUD_USERNAME=your-grafana-instance-id
GRAFANA_CLOUD_API_KEY=your-grafana-api-key

# ---- Local monitoring stack (docker-compose.monitoring.yml) ----
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me

# ---- Drift detection (deployment/monitoring/drift/) ----
DRIFT_BASELINE_GCS_URI=gs://your-mlflow-bucket/monitoring/baseline_data.csv
# SLACK_WEBHOOK_URL=  # only needed if alert_config.yaml flips slack.enabled=true

# ---- Email alerts (drift_detector.py + CI workflow notifications) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=example@gmail.com
SMTP_PASSWORD=your-16-char-app-password
ALERT_EMAIL_FROM=example@gmail.com
ALERT_EMAIL_LIST=alert-recipient-1@example.com,alert-recipient-2@example.com

# ---- Frontend build-time (baked into the Vite bundle, not runtime) ----
VITE_API_BASE=
VITE_DEFAULT_USER_ID=U00001

# ---- LLM APIs (optional — Vertex AI uses ADC by default) ----
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_API_KEY=AIza...
# OPEN_ROUTER_API_KEY=sk-or-v1-...
