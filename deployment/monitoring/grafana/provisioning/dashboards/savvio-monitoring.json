        { "expr": "savvio_dp_feature_engineering_duration_seconds", "legendFormat": "features/{{dataset}}", "refId": "C", "instant": true },
        { "expr": "savvio_dp_db_load_duration_seconds", "legendFormat": "db_load/{{table}}", "refId": "D", "instant": true }
