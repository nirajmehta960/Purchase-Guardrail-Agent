      "targets": [
        { "expr": "savvio_dp_db_load_rows_total", "legendFormat": "{{table}}", "refId": "A", "instant": true }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal", "displayMode": "gradient" }
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 80 }, { "color": "green", "value": 95 }] },
          "unit": "percent",
          "min": 0, "max": 100
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 44 },
