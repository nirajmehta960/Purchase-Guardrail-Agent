      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1800 }, { "color": "red", "value": 3600 }] } }
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 28 },
      "id": 22,
      "title": "Last Run Duration",
      "type": "stat",
      "targets": [
        { "expr": "savvio_dp_pipeline_total_duration_seconds", "legendFormat": "Duration", "refId": "A", "instant": true }
