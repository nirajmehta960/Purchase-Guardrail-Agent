#!/bin/bash
set -e

# Install Docker from official repo
apt-get update
apt-get install -y ca-certificates curl gnupg git
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
chmod a+r /etc/apt/keyrings/docker.gpg
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian $(. /etc/os-release && echo $VERSION_CODENAME) stable" \
  > /etc/apt/sources.list.d/docker.list
apt-get update
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
systemctl enable docker
systemctl start docker

# Provision the CI user for SSH access
id ${ci_ssh_user} &>/dev/null || useradd -m -s /bin/bash ${ci_ssh_user}
usermod -aG docker ${ci_ssh_user}
mkdir -p /home/${ci_ssh_user}/.ssh

%{ if length(ci_ssh_public_keys) > 0 ~}
cat > /home/${ci_ssh_user}/.ssh/authorized_keys <<'AUTHORIZED_KEYS_EOF'
%{ for key in ci_ssh_public_keys ~}
${key}
%{ endfor ~}
AUTHORIZED_KEYS_EOF
%{ else ~}
touch /home/${ci_ssh_user}/.ssh/authorized_keys
%{ endif ~}

chmod 700 /home/${ci_ssh_user}/.ssh
chmod 600 /home/${ci_ssh_user}/.ssh/authorized_keys
chown -R ${ci_ssh_user}:${ci_ssh_user} /home/${ci_ssh_user}/.ssh
