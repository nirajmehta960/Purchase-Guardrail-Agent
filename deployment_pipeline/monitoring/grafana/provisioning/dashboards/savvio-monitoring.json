          },
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "id": 7,
      "title": "Evaluation Mode",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (evaluation_mode) (rate(savvio_inference_total[5m]))",
          "legendFormat": "{{evaluation_mode}}",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
