# PostgreSQL
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow
POSTGRES_DB=mlflow

# S3 Credentials
AWS_ACCESS_KEY_ID=s3admin
AWS_SECRET_ACCESS_KEY=s3admin
AWS_DEFAULT_REGION=us-east-1

# RustFS
RUSTFS_CONSOLE_ENABLE=true
S3_BUCKET=mlflow

# MLflow docker-compose infrastructure (local only)
MLFLOW_VERSION=v3.10.1
MLFLOW_HOST=0.0.0.0
MLFLOW_PORT=5001
MLFLOW_SERVER_ALLOWED_HOSTS=mlflow-server,mlflow-server:5001,localhost,localhost:5001,localhost

MLFLOW_BACKEND_STORE_URI=postgresql://mlflow:mlflow@postgres:5432/mlflow
MLFLOW_ARTIFACTS_DESTINATION=s3://mlflow
MLFLOW_S3_ENDPOINT_URL=http://storage:9000

# MLFLOW_TRACKING_URI — where run_pipeline.py logs experiments
# Local docker-compose: http://mlflow-server:5001
# Prod/CI: injected automatically by the workflow from Cloud Run — do not set here for CI
MLFLOW_TRACKING_URI=http://mlflow-server:5001

# GCP — used by config.py for Artifact Registry
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-east1
# Override the Artifact Registry repo name only if your team uses a custom one.
# ARTIFACT_REGISTRY_REPO=savvio-model-repo

# ---------------------------------------------------------------------------------
# Reproducibility — pipeline-wide deterministic knobs
# ---------------------------------------------------------------------------------
# Override only if you knowingly want a different seed / dataset size for an
# experiment. Defaults match the values pinned in src/config.py.
# RANDOM_STATE=42
# N_SCENARIOS=50000
# MLFLOW_EXPERIMENT_NAME=SavVio_Prediction
# CI_METRICS_DIR=/path/where/CI/reads/metrics.txt   # default: model_pipeline/

# ---------------------------------------------------------------------------------
# Embeddings — MUST match the data pipeline (vector_embed.py reads the same vars)
# ---------------------------------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ---------------------------------------------------------------------------------
# Application Database (Training Data Source)
# Local: host.docker.internal reaches your Mac postgres from inside Docker
# Prod/CI: injected via GitHub Secrets — do not set here for CI
# ---------------------------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=your-local-postgres-password
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=postgres

# ---------------------------------------------------------------------------------
# LLM — Vertex AI (active provider)
# GCP-native, no API key required — uses Application Default Credentials.
# Supported providers: vertex, openrouter, mock.
#
# Local dev setup:
#   1. gcloud auth application-default login
#   2. Set VERTEX_PROJECT to your GCP project ID below.
#
# In prod/dev Cloud Run the service account gets roles/aiplatform.user
# automatically via Terraform — no additional secrets needed.
# ---------------------------------------------------------------------------------
VERTEX_PROJECT=your-gcp-project-id
VERTEX_LOCATION=us-east1
# Optional: override the model / location defaults baked into llm_provider.py
# VERTEX_MODEL=gemini-2.5-flash
# VERTEX_DEFAULT_MODEL=gemini-2.5-flash
# VERTEX_DEFAULT_LOCATION=us-east1

# ---------------------------------------------------------------------------------
# LLM — OpenRouter (fallback provider, opt-in)
# Set OPEN_ROUTER_API_KEY to enable. See OpenRouterProvider in
# src/llm/llm_provider.py for pricing and supported models.
# ---------------------------------------------------------------------------------
# OPEN_ROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=google/gemini-2.5-flash