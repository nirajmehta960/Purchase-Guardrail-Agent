# PostgreSQL
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=mlflow
POSTGRES_DB=mlflow

# S3 Credentials
AWS_ACCESS_KEY_ID=s3admin
AWS_SECRET_ACCESS_KEY=s3admin
AWS_DEFAULT_REGION=us-east-1

# RustFS
RUSTFS_CONSOLE_ENABLE=true
S3_BUCKET=mlflow

# MLflow docker-compose infrastructure (local only)
MLFLOW_VERSION=v3.10.1
MLFLOW_HOST=0.0.0.0
MLFLOW_PORT=5001
MLFLOW_SERVER_ALLOWED_HOSTS=mlflow-server,mlflow-server:5001,localhost,localhost:5001,localhost

MLFLOW_BACKEND_STORE_URI=postgresql://mlflow:mlflow@postgres:5432/mlflow
MLFLOW_ARTIFACTS_DESTINATION=s3://mlflow
MLFLOW_S3_ENDPOINT_URL=http://storage:9000

# MLFLOW_TRACKING_URI — where run_pipeline.py logs experiments
# Local docker-compose: http://mlflow-server:5001
# Prod/CI: injected automatically by the workflow from Cloud Run — do not set here for CI
MLFLOW_TRACKING_URI=http://mlflow-server:5001

# GCP — used by config.py for Artifact Registry
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-east1

# ---------------------------------------------------------------------------------
# Application Database (Training Data Source)
# Local: host.docker.internal reaches your Mac postgres from inside Docker
# Prod/CI: injected via GitHub Secrets — do not set here for CI
# ---------------------------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=your-local-postgres-password
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=postgres